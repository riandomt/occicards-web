<div class="modal fade" id="updateModal" tabindex="-1" aria-labelledby="updateModalLabel" aria-hidden="true">
	<div class="modal-dialog modal-lg">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title" id="updateModalLabel">Modifier la carte</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			
			<form id="cardForm"  novalidate onsubmit="return false;">
				<div class="modal-body">
					<div class="mb-3">
						<label for="question" class="form-label">Question</label>
						<textarea class="form-control" id="card_question" rows="4"></textarea>
					</div>
					
					<div class="mb-3">
						<label for="answer" class="form-label">Réponse</label>
						<textarea class="form-control" id="card_answer" rows="4"></textarea>
					</div>
				</div>
				
				<div class="modal-footer">
					<button class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
					<button type="button" id="btnUpdateCard" class="btn btn-primary" >Modifier</button>
				</div>
			</form>

		</div>
	</div>
</div>
